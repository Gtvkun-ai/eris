+    monkeypatch.delenv("ERIS_DS2API_API_KEY", raising=False)
+    monkeypatch.setattr(pm, "get_provider_profile", lambda *args, **kwargs: {})
+    monkeypatch.setattr(pm, "_bootstrap_pool_key", lambda pool: "")
