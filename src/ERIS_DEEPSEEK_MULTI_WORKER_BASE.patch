+Output schema:
+{
+  "claim": "string — the distilled stable fact",
+  "fact_key": "string — best matching key or empty string",
+  "domain": "user|self|world|technical|project|relationship|unknown",
+  "confidence": 0.0-1.0,
+  "decay_policy": "slow|normal|fast",
