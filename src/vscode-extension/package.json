{
  "name": "eris-vscode",
  "displayName": "Eris",
  "description": "Eris coding agent cho VS Code: giao việc tự nhiên, Plan, Tự động, chọn model và workflow tối giản.",
  "version": "0.16.2",
  "publisher": "gtvk",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:eris.mainView",
    "onChatParticipant:gtvk.eris",
    "onCommand:eris.openChat",
    "onCommand:eris.newChat",
    "onCommand:eris.openTask",
    "onCommand:eris.serviceStart",
    "onCommand:eris.serviceRestart",
    "onCommand:eris.serviceStop",
    "onCommand:eris.serviceLogs",
    "onCommand:eris.selfTest"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eris.openChat",
        "title": "Eris: Open Chat"
      },
      {
        "command": "eris.newChat",
        "title": "Eris: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "eris.reconnect",
        "title": "Eris: Reconnect Service",
        "icon": "$(refresh)"
      },
      {
        "command": "eris.openTask",
        "title": "Eris: Open Task"
      },
      {
        "command": "eris.serviceStart",
        "title": "Eris: Start Service"
      },
      {
        "command": "eris.serviceRestart",
        "title": "Eris: Restart Service"
      },
      {
        "command": "eris.serviceStop",
        "title": "Eris: Stop Managed Service"
      },
      {
        "command": "eris.serviceLogs",
        "title": "Eris: Show Service Logs"
      },
      {
        "command": "eris.selfTest",
        "title": "Eris: Run Self Test",
        "icon": "$(beaker)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eris.agentSidebar",
          "title": "Eris",
          "icon": "media/eris.svg"
        }
      ]
    },
    "views": {
      "eris.agentSidebar": [
        {
          "type": "webview",
          "id": "eris.mainView",
          "name": "Eris",
          "contextualTitle": "Eris",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Eris",
      "properties": {
        "eris.service.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Cho phép extension tự khởi động Eris Service khi connectionMode=service hoặc khi auto không có Direct API khả dụng. Lệnh Eris: Start Service vẫn khởi động thủ công."
        },
        "eris.service.connectionMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "service",
            "directApi"
          ],
          "enumDescriptions": [
            "Attach vào Eris Service nếu đang chạy; nếu không có service và đã cấu hình API key thì dùng Direct API, không tự bật Eris.",
            "Luôn dùng Eris Service/IDE bridge và tự khởi động backend khi cần.",
            "Luôn dùng Direct API; không đọc discovery, không khởi động Eris Service."
          ],
          "description": "Chọn cách Eris VS Code gửi tin nhắn. Direct API phù hợp khi chỉ muốn chat bằng official/external API mà không bật runtime Eris."
        },
        "eris.service.installRoot": {
          "type": "string",
          "default": "",
          "description": "Thư mục cài Eris chứa run_eris_service.bat/run_eris.bat. Chỉ cần đặt một lần nếu auto-detect không thấy."
        },
        "eris.service.launchCommand": {
          "type": "string",
          "default": "",
          "description": "Lệnh launch Eris tùy chỉnh. Khi có giá trị, lệnh này được ưu tiên hơn auto-detect launcher."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "gtvk.eris",
        "name": "eris",
        "fullName": "Eris",
        "description": "Hỏi Eris về code, giao task hoặc tiếp tục task LangGraph hiện tại.",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Tìm root cause, sửa code và kiểm chứng"
          },
          {
            "name": "plan",
            "description": "Lập kế hoạch thực thi, không tạo side effect"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "vscode:prepublish": "node esbuild.js --production",
    "package:vsix": "python package_vsix.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.8.0",
    "esbuild": "^0.25.0"
  }
}
