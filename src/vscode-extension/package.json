{
  "name": "eris-vscode",
  "displayName": "Eris",
  "description": "VS Code client cho Eris Service và LangGraph agent.",
  "version": "0.3.0",
  "publisher": "gtvk",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onView:eris.sidebar",
    "onCommand:eris.openChat",
    "onCommand:eris.newChat",
    "onCommand:eris.openTask",
    "onCommand:eris.serviceStart",
    "onCommand:eris.serviceRestart",
    "onCommand:eris.serviceStop",
    "onCommand:eris.serviceLogs"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eris.openChat",
        "title": "Eris: Open Chat"
      },
      {
        "command": "eris.newChat",
        "title": "Eris: New Chat"
      },
      {
        "command": "eris.reconnect",
        "title": "Eris: Reconnect Service"
      },
      {
        "command": "eris.openTask",
        "title": "Eris: Open Task"
      },
      {
        "command": "eris.serviceStart",
        "title": "Eris: Start Service"
      },
      {
        "command": "eris.serviceRestart",
        "title": "Eris: Restart Service"
      },
      {
        "command": "eris.serviceStop",
        "title": "Eris: Stop Managed Service"
      },
      {
        "command": "eris.serviceLogs",
        "title": "Eris: Show Service Logs"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "eris",
          "title": "Eris",
          "icon": "media/eris.svg"
        }
      ]
    },
    "views": {
      "eris": [
        {
          "id": "eris.sidebar",
          "name": "Eris"
        }
      ]
    },
    "configuration": {
      "title": "Eris",
      "properties": {
        "eris.service.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Tự khởi động Eris khi VS Code cần kết nối nhưng service chưa chạy."
        },
        "eris.service.installRoot": {
          "type": "string",
          "default": "",
          "description": "Thư mục cài Eris chứa run_eris.bat/run_eris.sh. Chỉ cần đặt một lần nếu auto-detect không thấy."
        },
        "eris.service.launchCommand": {
          "type": "string",
          "default": "",
          "description": "Lệnh launch Eris tùy chỉnh. Khi có giá trị, lệnh này được ưu tiên hơn auto-detect launcher."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.8.0"
  }
}
