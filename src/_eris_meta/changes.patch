+
+        def refresh_configuration(self):
+            return False
+
+        def speak(self, text, **kwargs):
+            callback = kwargs.get("on_event")
+            if callback is not None:
+                callback(StageAudioEvent(
+                    type="audio_start",
+                    turn_id=str(kwargs.get("turn_id", "")),
+                    segment_id=int(kwargs.get("segment_id", 0)),
+                    text=str(text),
+                ))
+                callback(StageAudioEvent(
+                    type="audio_done",
