# DeepSeek Web / Whale2API endpoint used by all configured roles.
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=deepseek_web
ERIS_DS2API_ENABLED=1
ERIS_DS2API_FAILFAST_TIMEOUT_S=300
ERIS_DS_MODEL=deepseek-v4-flash

# ── Multi-instance DS2API (High Availability) ──────────────────────────────
# Chạy nhiều Whale2API instance song song, mỗi instance trên một port riêng.
# vision.py sẽ auto-start tất cả khi khởi động.
#
# Mapping khuyến nghị (4 instance):
#   6011 → companion (critical path, main chat)
#   6012 → surface   (autonomous speech, time-sensitive)
#   6013 → observer + style (post-turn async)
#   6014 → critic + inner + research (background)
#
# Single-instance (cũ, tương thích ngược):
# ERIS_DS2API_PORTS=6011
# ERIS_DS_BASE_URL=http://127.0.0.1:6011/v1

# Multi-instance: khai báo 4 port, mỗi worker trỏ về instance riêng.
ERIS_DS2API_PORTS=6011,6012,6013,6014

# Per-role base URL — mỗi worker trỏ về đúng instance của nó.
ERIS_DS_COMPANION_BASE_URL=http://127.0.0.1:6011/v1
ERIS_DS_SURFACE_BASE_URL=http://127.0.0.1:6012/v1
ERIS_DS_OBSERVER_BASE_URL=http://127.0.0.1:6013/v1
ERIS_DS_STYLE_BASE_URL=http://127.0.0.1:6013/v1
ERIS_DS_CRITIC_BASE_URL=http://127.0.0.1:6014/v1
ERIS_DS_INNER_BASE_URL=http://127.0.0.1:6014/v1
ERIS_DS_RESEARCH_BASE_URL=http://127.0.0.1:6014/v1

# Fallback base URL cho các role chưa có BASE_URL riêng.
ERIS_DS_BASE_URL=http://127.0.0.1:6011/v1
# ───────────────────────────────────────────────────────────────────────────

# Main public semantic authority. One request returns the full UtteranceSpec.
ERIS_DS_COMPANION_API_KEY=
ERIS_MAIN_SEMANTIC_DEADLINE_SEC=300
ERIS_CHAT_FORMAT_FALLBACK_ENABLED=0
ERIS_ESCALATION_ENABLED=0

# Optional non-critical workers.
ERIS_DS_SURFACE_API_KEY=
ERIS_DS_SURFACE_ALLOW_SHARED_KEY=1
ERIS_DS_OBSERVER_API_KEY=
ERIS_DS_CRITIC_API_KEY=
ERIS_DS_INNER_API_KEY=
ERIS_DS_RESEARCH_API_KEY=
ERIS_INNER_DIARY_WORKER_ROLE=inner
ERIS_INNER_DIARY_ALLOW_FALLBACK=0

ERIS_DS_OBSERVER_JSONL=1
ERIS_DS_SURFACE_JSONL=1
ERIS_DS_CRITIC_JSONL=1
ERIS_DS_INNER_JSONL=1
ERIS_DS_RESEARCH_JSONL=1
ERIS_DS_COMPANION_JSONL=0
ERIS_DS_JSONL_REPAIR_ATTEMPTS=1

ERIS_SURFACE_INTENT_ENABLED=1
ERIS_SOCIAL_INITIATIVE_TIMEOUT_SEC=3
ERIS_SOCIAL_INITIATIVE_SOFT_SILENCE_SEC=180
ERIS_SOCIAL_INITIATIVE_HARD_SILENCE_SEC=600
ERIS_SOCIAL_INITIATIVE_PROBE_INTERVAL_SEC=90
ERIS_SURFACE_REALIZER_TIMEOUT_SEC=12
ERIS_SURFACE_LOCAL_FALLBACK_ENABLED=1
ERIS_DS_SURFACE_JSONL_REPAIR_ATTEMPTS=0
ERIS_DS_SURFACE_DROP_IF_BUSY=1

# Public rendering is local after semantic commit.
ERIS_VOICE_DIRECTOR_ENABLED=0
ERIS_TTS_STAGE_LOCALIZE=1
ERIS_TTS_LANGUAGE=ja
ERIS_TTS_SYNC_TEXT=1
ERIS_TTS_TEXT_SYNC_TIMEOUT=30
