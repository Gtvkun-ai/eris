# Shared Whale2API endpoint/model
ERIS_DS_BASE_URL=http://127.0.0.1:6011/v1
ERIS_DS_MODEL=deepseek-v4-flash
ERIS_DS2API_ENABLED=1

# One Whale2API gateway key per cognitive role
ERIS_DS_COMPANION_API_KEY=
ERIS_DS_SURFACE_API_KEY=
# V18 mặc định dùng chung DS2API gateway/account pool. Đặt 0 nếu muốn key/account riêng.
ERIS_DS_SURFACE_ALLOW_SHARED_KEY=1
ERIS_DS_OBSERVER_API_KEY=
ERIS_DS_CRITIC_API_KEY=
ERIS_DS_INNER_API_KEY=
# Inner Diary uses exactly one existing DeepSeek role (default: inner).
ERIS_INNER_DIARY_WORKER_ROLE=inner
ERIS_INNER_DIARY_ALLOW_FALLBACK=0
ERIS_DS_STYLE_API_KEY=
ERIS_DS_RESEARCH_API_KEY=

# Structured worker output
ERIS_DS_OBSERVER_JSONL=1
ERIS_DS_SURFACE_JSONL=1
ERIS_DS_CRITIC_JSONL=1
ERIS_DS_INNER_JSONL=1
ERIS_DS_RESEARCH_JSONL=1
ERIS_DS_STYLE_JSONL=1
ERIS_DS_JSONL_REPAIR_ATTEMPTS=1

# V18: cùng role=surface đề xuất social candidate rồi viết wording sau governor.
ERIS_SURFACE_INTENT_ENABLED=1
ERIS_SOCIAL_INITIATIVE_TIMEOUT_SEC=3
ERIS_SOCIAL_INITIATIVE_SOFT_SILENCE_SEC=180
ERIS_SOCIAL_INITIATIVE_HARD_SILENCE_SEC=600
ERIS_SOCIAL_INITIATIVE_PROBE_INTERVAL_SEC=90
ERIS_SURFACE_REALIZER_TIMEOUT_SEC=4
ERIS_SURFACE_LOCAL_FALLBACK_ENABLED=1
ERIS_DS_SURFACE_JSONL_REPAIR_ATTEMPTS=0
ERIS_DS_SURFACE_DROP_IF_BUSY=1

# STYLE warmth director (single take; fail-fast)
ERIS_VOICE_DIRECTOR_ENABLED=1
ERIS_VOICE_DIRECTOR_TIMEOUT_S=3
