# ================================================================
# Semantic memory / embedding
# ================================================================

# Bật embedding. Nếu torch/transformers chưa có, hệ thống tự fallback lexical.
ERIS_EMBEDDING_ENABLED=1

# Model đề xuất. Adapter đã tự nhận Qwen3, dùng query instruction và last-token pooling.
ERIS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# 512 đủ cho fact/query ngắn và nhẹ CPU/GPU hơn. Có thể tăng nếu embed episode dài.
ERIS_EMBEDDING_MAX_LENGTH=512

# auto: Qwen3 -> last_token, MiniLM/E5 -> mean.
ERIS_EMBEDDING_POOLING=auto

# Instruction chỉ gắn vào QUERY, không gắn vào document.
ERIS_EMBEDDING_QUERY_INSTRUCTION=Given a colloquial Vietnamese memory question, retrieve facts or conversation evidence that directly answer it.

# Raw cosine. Hãy hiệu chỉnh bằng benchmark tiếng Việt của ERIS thay vì đoán.
ERIS_MEMORY_QUERY_MIN_COSINE=0.38
ERIS_EMBEDDING_MIN_COSINE=0.20

# Tuỳ chọn: lưu predicate provisional do semantic model tạo để có thêm một lớp bền vững.
# Nếu bỏ trống, registry vẫn được hydrate từ semantic memory lúc khởi động.
ERIS_PREDICATE_REGISTRY_PATH=

# ================================================================
# Living user memory / tổng hợp profile người dùng
# ================================================================

# Tắt toàn bộ projection/profile mới nhưng không xóa dữ liệu đã lưu.
ERIS_LIVING_USER_MODEL_ENABLED=1

# Học các preference rõ từ user turn, ví dụ ngôn ngữ chú thích và cách giao file.
ERIS_LIVING_USER_AUTO_OBSERVE=1

# Đồng bộ semantic claim user.* vào living profile.
ERIS_LIVING_USER_SYNC_SEMANTIC=1

# Maintenance/session flush được phép consolidate episode vào profile.
ERIS_LIVING_USER_AUTO_DREAM=1

# Ngân sách context mặc định dành cho profile + episode liên quan.
ERIS_LIVING_USER_CONTEXT_TOKENS=900

# ================================================================
# Memory GC / DeepSeek critic curator
# ================================================================

# Chạy daemon dọn memory khi runtime idle. Mặc định mới là 10 phút.
ERIS_MEMORY_GC_ENABLED=1
ERIS_MEMORY_GC_INTERVAL_SEC=600
ERIS_MEMORY_GC_STARTUP_DELAY_SEC=120

# Bắt buộc ưu tiên worker critic. Mặc định KHÔNG fallback sang Gemma/main model,
# tránh dựng model ghi sổ lên chỉ để quét rác.
ERIS_MEMORY_GC_ALLOW_MODEL_FALLBACK=0
ERIS_MEMORY_GC_CRITIC_TIMEOUT_SEC=45

# Giới hạn batch để critic không phải đọc cả file profile như đọc gia phả.
ERIS_MEMORY_GC_DS_LIMIT=80
ERIS_MEMORY_GC_LIVING_LIMIT=40
ERIS_MEMORY_GC_LIVING_CLUSTER_LIMIT=10

# Qwen embedding dùng để gom duplicate/near-duplicate trước khi gọi critic.
ERIS_MEMORY_GC_LIVING_DUPLICATE_COSINE=0.86

# Profile không đổi thì bỏ qua các lượt 10 phút tiếp theo; tối đa mỗi ngày rà lại
# một lần để xử lý decay/TTL dù version không đổi.
ERIS_MEMORY_GC_LIVING_REVIEW_MAX_AGE_SEC=86400
ERIS_MEMORY_GC_LIVING_STALE_DAYS=90

# Chỉ giữ undo window ngắn. Evidence canonical vẫn nằm ở event/semantic store.
ERIS_LIVING_USER_HISTORY_SNAPSHOTS=8
