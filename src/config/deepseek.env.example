# Main ERIS brain: official DeepSeek OpenAI-compatible API.
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=deepseek
DEEPSEEK_API_KEY=PASTE_DEEPSEEK_API_KEY_HERE
ERIS_REMOTE_BASE_URL=https://api.deepseek.com
ERIS_REMOTE_MODEL=deepseek-v4-flash

# Global fallback defaults. V36 can override thinking per request: literary or
# relational Pro turns stay non-thinking; abstract/technical Pro turns enable
# thinking automatically.
ERIS_DEEPSEEK_THINKING=disabled
ERIS_DEEPSEEK_REASONING_EFFORT=high

# Companion-aware Flash/Pro routing. These are live runtime settings and can be
# changed through runtime_settings.json as well.
ERIS_COMPANION_ROUTING_ENABLED=1
ERIS_COMPANION_PRO_THRESHOLD=0.58
ERIS_COMPANION_MAX_REASONING_THRESHOLD=0.86
ERIS_COMPANION_STYLE_USES_PRO=1
ERIS_COMPANION_ABSTRACT_USES_PRO=1
ERIS_COMPANION_RELATIONAL_USES_PRO=1
ERIS_COMPANION_CONTEXT_USES_PRO=1
ERIS_COMPANION_SIMPLE_STAYS_FLASH=1

# Stronger escalation lane. V36 creates DeepSeek Pro automatically and reuses
# DEEPSEEK_API_KEY unless a dedicated ERIS_ESCALATION_API_KEY is provided.
ERIS_ESCALATION_ENABLED=1
ERIS_ESCALATION_PROVIDER=deepseek
ERIS_ESCALATION_MODEL=deepseek-v4-pro

# ShopAIKey-style implicit vision fallback was removed. DeepSeek's public chat
# endpoint is treated as text-only. Leave local vision enabled, or configure a
# separate multimodal provider explicitly.
ERIS_VISION_API_ENABLED=0
# ERIS_VISION_API_KEY=PASTE_MULTIMODAL_KEY_HERE
# ERIS_VISION_API_BASE_URL=https://your-multimodal-provider.example/v1
# ERIS_VISION_API_MODEL=your-vision-model

# Optional independent format fallback. No provider is contacted unless all
# three values are explicitly configured.
ERIS_CHAT_FORMAT_FALLBACK_ENABLED=1
# ERIS_CHAT_FALLBACK_API_KEY=PASTE_FALLBACK_KEY_HERE
# ERIS_CHAT_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# ERIS_CHAT_FALLBACK_MODEL=llama-3.1-8b-instant

# Chess.com companion bridge
ERIS_CHESS_BRIDGE_ENABLED=1
ERIS_CHESS_BRIDGE_HOST=127.0.0.1
ERIS_CHESS_BRIDGE_PORT=8765
ERIS_CHESS_BRIDGE_TOKEN=
ERIS_CHESS_ANALYSIS_DEPTH=2
ERIS_CHESS_DIRECT_MOVE_RATE=0.18
ERIS_CHESS_MAX_BODY_BYTES=65536
