# ---------------------------------------------------------------------------
# Main semantic authority: DeepSeek Web through Whale2API / DS2API
# ---------------------------------------------------------------------------
# The public reply path performs one remote semantic commit. It does not call
# the official DeepSeek API, Gemini, Groq, a Voice Director model, or a second
# translation model after the reply.
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=deepseek_web
ERIS_DS2API_ENABLED=1
ERIS_DS_BASE_URL=http://127.0.0.1:6011/v1
ERIS_DS_MODEL=deepseek-v4-flash
ERIS_DS_COMPANION_API_KEY=PASTE_WHALE2API_GATEWAY_KEY_HERE

# One Main Web turn owns semantic_frame + assistant_act + bilingual surfaces +
# performance preset. On deadline/failure the turn degrades locally instead of
# waiting for another semantic provider in series.
ERIS_MAIN_SEMANTIC_DEADLINE_SEC=12
ERIS_CHAT_FORMAT_FALLBACK_ENABLED=0
ERIS_ESCALATION_ENABLED=0
ERIS_COMPANION_ROUTING_ENABLED=0
ERIS_DEEPSEEK_THINKING=disabled
ERIS_DEEPSEEK_REASONING_EFFORT=high

# Screen understanding remains an explicit route. Ordinary chat does not take a
# screenshot or wait for vision unless the user's message refers to the screen.
ERIS_CHAT_MAIN_VISION=0
ERIS_VISION_COMPRESSOR=1
ERIS_VISION_API_ENABLED=1
ERIS_VISION_API_PROVIDER=groq
ERIS_VISION_API_BASE_URL=https://api.groq.com/openai/v1
ERIS_VISION_API_MODEL=qwen/qwen3.6-27b
# ERIS_VISION_API_KEY=optional; leave empty to use ERIS_GROQ_API_KEY / key pool.

# ---------------------------------------------------------------------------
# Optional DeepSeek Web workers outside the public critical path
# ---------------------------------------------------------------------------
# These workers may observe, remember, research, or critique asynchronously.
# They are not permitted to rewrite a committed public UtteranceSpec.
ERIS_DS_SURFACE_API_KEY=
ERIS_DS_SURFACE_ALLOW_SHARED_KEY=1
ERIS_DS_OBSERVER_API_KEY=
ERIS_DS_CRITIC_API_KEY=
ERIS_DS_INNER_API_KEY=
ERIS_DS_RESEARCH_API_KEY=
ERIS_INNER_DIARY_WORKER_ROLE=inner
ERIS_INNER_DIARY_ALLOW_FALLBACK=0

ERIS_DS_OBSERVER_JSONL=1
ERIS_DS_SURFACE_JSONL=1
ERIS_DS_CRITIC_JSONL=1
ERIS_DS_INNER_JSONL=1
ERIS_DS_RESEARCH_JSONL=1
ERIS_DS_COMPANION_JSONL=0
ERIS_DS_JSONL_REPAIR_ATTEMPTS=1

# Autonomous wording may use the Web surface worker, but the complete bilingual
# utterance still comes from one call and is committed atomically.
ERIS_SURFACE_INTENT_ENABLED=1
ERIS_SOCIAL_INITIATIVE_TIMEOUT_SEC=3
ERIS_SOCIAL_INITIATIVE_SOFT_SILENCE_SEC=180
ERIS_SOCIAL_INITIATIVE_HARD_SILENCE_SEC=600
ERIS_SOCIAL_INITIATIVE_PROBE_INTERVAL_SEC=90
ERIS_SURFACE_REALIZER_TIMEOUT_SEC=12
ERIS_SURFACE_LOCAL_FALLBACK_ENABLED=1
ERIS_DS_SURFACE_JSONL_REPAIR_ATTEMPTS=0
ERIS_DS_SURFACE_DROP_IF_BUSY=1

# ---------------------------------------------------------------------------
# Deterministic performance compiler + ElevenLabs
# ---------------------------------------------------------------------------
# Voice direction is compiled locally from utterance.performance. The legacy
# remote Voice Director and Speech Localizer are migration-only and disabled.
ERIS_VOICE_DIRECTOR_ENABLED=0
ERIS_TTS_STAGE_LOCALIZE=0
ERIS_TTS_LANGUAGE=ja

# Keep the bubble hidden while DeepSeek Web composes and ElevenLabs buffers.
# Godot shows the public lifecycle state and thinking body pose instead. The
# bubble is released on first audio; the timeout is only a deadman degradation.
ERIS_TTS_SYNC_TEXT=1
ERIS_TTS_TEXT_SYNC_TIMEOUT=30

# Official ElevenLabs API-key flow. Voice/model tuning is intentionally kept.
ELEVENLABS_API_KEY=
ERIS_TTS_PROVIDER=elevenlabs
ERIS_ELEVENLABS_VOICE_ID=
ERIS_ELEVENLABS_MODEL=eleven_v3
ERIS_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ERIS_ELEVENLABS_TIMEOUT_S=120
ERIS_ELEVENLABS_STABILITY=0.58
ERIS_ELEVENLABS_SIMILARITY_BOOST=0.78
ERIS_ELEVENLABS_STYLE=0.08
ERIS_ELEVENLABS_SPEAKER_BOOST=1
ERIS_ELEVENLABS_GEMINI_FALLBACK=1

# ---------------------------------------------------------------------------
# Chess.com companion bridge
# ---------------------------------------------------------------------------
# No artificial fast-path. Chess may use its normal deliberation/commentary
# cadence; the visible CALCULATING/COMPOSING state prevents silent waiting.
ERIS_CHESS_BRIDGE_ENABLED=1
ERIS_CHESS_BRIDGE_HOST=127.0.0.1
ERIS_CHESS_BRIDGE_PORT=8765
ERIS_CHESS_BRIDGE_TOKEN=
ERIS_CHESS_ANALYSIS_DEPTH=2
ERIS_CHESS_DIRECT_MOVE_RATE=0.18
ERIS_CHESS_MAX_BODY_BYTES=65536
