# Main ERIS brain: official DeepSeek OpenAI-compatible API.
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=deepseek
DEEPSEEK_API_KEY=PASTE_DEEPSEEK_API_KEY_HERE
ERIS_REMOTE_BASE_URL=https://api.deepseek.com
ERIS_REMOTE_MODEL=deepseek-v4-flash

# Global fallback defaults. V36 can override thinking per request: literary or
# relational Pro turns stay non-thinking; abstract/technical Pro turns enable
# thinking automatically.
ERIS_DEEPSEEK_THINKING=disabled
ERIS_DEEPSEEK_REASONING_EFFORT=high

# Companion-aware Flash/Pro routing. These are live runtime settings and can be
# changed through runtime_settings.json as well.
ERIS_COMPANION_ROUTING_ENABLED=1
ERIS_COMPANION_PRO_THRESHOLD=0.58
ERIS_COMPANION_MAX_REASONING_THRESHOLD=0.86
ERIS_COMPANION_STYLE_USES_PRO=1
ERIS_COMPANION_ABSTRACT_USES_PRO=1
ERIS_COMPANION_RELATIONAL_USES_PRO=1
ERIS_COMPANION_CONTEXT_USES_PRO=1
ERIS_COMPANION_SIMPLE_STAYS_FLASH=1

# Stronger escalation lane. V36 creates DeepSeek Pro automatically and reuses
# DEEPSEEK_API_KEY unless a dedicated ERIS_ESCALATION_API_KEY is provided.
ERIS_ESCALATION_ENABLED=1
ERIS_ESCALATION_PROVIDER=deepseek
ERIS_ESCALATION_MODEL=deepseek-v4-pro

# ShopAIKey-style implicit vision fallback was removed. DeepSeek's public chat
# endpoint is treated as text-only. Leave local vision enabled, or configure a
# separate multimodal provider explicitly.
ERIS_VISION_API_ENABLED=0
# ERIS_VISION_API_KEY=PASTE_MULTIMODAL_KEY_HERE
# ERIS_VISION_API_BASE_URL=https://your-multimodal-provider.example/v1
# ERIS_VISION_API_MODEL=your-vision-model

# Optional independent format fallback. No provider is contacted unless all
# three values are explicitly configured.
ERIS_CHAT_FORMAT_FALLBACK_ENABLED=1
# ERIS_CHAT_FALLBACK_API_KEY=PASTE_FALLBACK_KEY_HERE
# ERIS_CHAT_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# ERIS_CHAT_FALLBACK_MODEL=llama-3.1-8b-instant

# Chess.com companion bridge
ERIS_CHESS_BRIDGE_ENABLED=1
ERIS_CHESS_BRIDGE_HOST=127.0.0.1
ERIS_CHESS_BRIDGE_PORT=8765
ERIS_CHESS_BRIDGE_TOKEN=
ERIS_CHESS_ANALYSIS_DEPTH=2
ERIS_CHESS_DIRECT_MOVE_RATE=0.18
ERIS_CHESS_MAX_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# DeepSeek Web multi-worker foundation
# ---------------------------------------------------------------------------
# All workers use the same Whale2API OpenAI-compatible endpoint/model by
# default. Each bearer key should be a separate Whale2API gateway key pinned
# to the Gmail/DeepSeek account (or account pool) assigned to that role.
ERIS_DS_BASE_URL=http://127.0.0.1:6011/v1
ERIS_DS_MODEL=deepseek-v4-flash

ERIS_DS_COMPANION_API_KEY=
ERIS_DS_SURFACE_API_KEY=
# V18 reuses the configured DS2API gateway/account pool by default. Set 0
# only when Surface must have a dedicated key/account.
ERIS_DS_SURFACE_ALLOW_SHARED_KEY=1
ERIS_DS_OBSERVER_API_KEY=
ERIS_DS_CRITIC_API_KEY=
ERIS_DS_INNER_API_KEY=
# Inner Diary uses exactly one existing DeepSeek role (default: inner).
ERIS_INNER_DIARY_WORKER_ROLE=inner
ERIS_INNER_DIARY_ALLOW_FALLBACK=0
ERIS_DS_STYLE_API_KEY=
ERIS_DS_RESEARCH_API_KEY=

# Optional per-role endpoint/model overrides. Normally leave these unset.
# ERIS_DS_OBSERVER_BASE_URL=http://127.0.0.1:6011/v1
# ERIS_DS_OBSERVER_MODEL=deepseek-v4-flash

# Canonical one-line JSON is enabled for every structured worker. STYLE now
# returns a VoicePlan JSON side-channel, so JSONL must remain enabled.
ERIS_DS_OBSERVER_JSONL=1
ERIS_DS_SURFACE_JSONL=1
ERIS_DS_CRITIC_JSONL=1
ERIS_DS_INNER_JSONL=1
ERIS_DS_RESEARCH_JSONL=1
ERIS_DS_STYLE_JSONL=1
ERIS_DS_COMPANION_JSONL=0
ERIS_DS_JSONL_REPAIR_ATTEMPTS=1

# The companion key is also accepted as the primary DS2API key. The old
# ERIS_DS2API_API_KEY remains supported for backward compatibility.
ERIS_DS2API_ENABLED=1

# V18: role=surface owns two typed contracts: topic candidate and final wording.
# Runtime governor owns only permission/timing.
ERIS_SURFACE_INTENT_ENABLED=1
ERIS_SOCIAL_INITIATIVE_TIMEOUT_SEC=3
ERIS_SOCIAL_INITIATIVE_SOFT_SILENCE_SEC=180
ERIS_SOCIAL_INITIATIVE_HARD_SILENCE_SEC=600
ERIS_SOCIAL_INITIATIVE_PROBE_INTERVAL_SEC=90
ERIS_SURFACE_REALIZER_TIMEOUT_SEC=4
ERIS_SURFACE_LOCAL_FALLBACK_ENABLED=1
ERIS_DS_SURFACE_JSONL_REPAIR_ATTEMPTS=0
ERIS_DS_SURFACE_DROP_IF_BUSY=1
# ---------------------------------------------------------------------------
# ERIS Voice Director + ElevenLabs
# ---------------------------------------------------------------------------
# STYLE only selects a subtle single-take warmth profile. Fail fast so this
# optional polish never holds the public reply hostage.
ERIS_VOICE_DIRECTOR_ENABLED=1
ERIS_VOICE_DIRECTOR_TIMEOUT_S=3

# Official ElevenLabs API-key flow. Never put email/password/Firebase tokens here.
ELEVENLABS_API_KEY=
ERIS_TTS_PROVIDER=elevenlabs
ERIS_ELEVENLABS_VOICE_ID=
ERIS_ELEVENLABS_MODEL=eleven_v3
ERIS_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ERIS_ELEVENLABS_TIMEOUT_S=120
ERIS_ELEVENLABS_STABILITY=0.58
ERIS_ELEVENLABS_SIMILARITY_BOOST=0.78
ERIS_ELEVENLABS_STYLE=0.08
ERIS_ELEVENLABS_SPEAKER_BOOST=1
# Keep Gemini/local providers as safety fallback while tuning the new voice.
ERIS_ELEVENLABS_GEMINI_FALLBACK=1
