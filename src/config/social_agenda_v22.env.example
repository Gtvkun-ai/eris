# Eris social agenda V22: full cutover. There is no shadow/control/canary mode.
# All four social-plan lanes are live: afterbeat, exposure, conversation_arc,
# and social_agenda. Safety, floor ownership, atomic claims and boundary state
# remain mandatory; removing the old flow does not mean removing brakes.

# Durable compare-and-swap state for afterbeat, social exposure, arc and agenda.
ERIS_SOCIAL_ATOMIC_BACKEND=sqlite
ERIS_SOCIAL_ATOMIC_DB=memory/eris_social_runtime.sqlite3

# Reuse committed public-turn results across retries/workers.
ERIS_DURABLE_PUBLIC_TURNS=1

# Cross-session social memory stays explicit. Full runtime does not silently
# turn session observations into a permanent profile.
ERIS_SOCIAL_AGENDA_CROSS_SESSION=0

# Agenda initiative timing. These are runtime gates, not rollout percentages.
ERIS_SOCIAL_INITIATIVE_SOFT_SILENCE_SEC=180
ERIS_SOCIAL_INITIATIVE_HARD_SILENCE_SEC=600
ERIS_SOCIAL_INITIATIVE_PROBE_INTERVAL_SEC=45
