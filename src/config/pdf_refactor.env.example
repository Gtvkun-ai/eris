# ERIS architecture PDF rollout example
# Copy only the values you deliberately want to override into your local .env.

ERIS_INFERENCE_BROKER_ENABLED=1
ERIS_BROKER_MODE=enforce

# Recommended rollout order from PDF pages 19-20:
# post_observer -> memory_digest -> vision_ambient -> private_mind -> tutor_background -> chat_main
ERIS_BROKER_MODE_POST_OBSERVER=enforce
ERIS_BROKER_MODE_MEMORY_DIGEST=enforce
ERIS_BROKER_MODE_VISION_AMBIENT=enforce
ERIS_BROKER_MODE_PRIVATE_MIND=enforce
ERIS_BROKER_MODE_TUTOR_BACKGROUND=enforce
ERIS_BROKER_MODE_CHAT_MAIN=enforce

# Example canary:
# ERIS_BROKER_MODE_CHAT_MAIN=canary
# ERIS_BROKER_CANARY_PERCENT_CHAT_MAIN=10

# Optional-first kill switches:
# ERIS_BROKER_KILL_VISION_AMBIENT=1
# ERIS_BROKER_KILL_TUTOR_BACKGROUND=1

ERIS_SEMANTIC_SHADOW_ENABLED=1
ERIS_DEGRADED_CHAT_FASTPATH=1

ERIS_BROKER_HOT_UTILIZATION=0.82
ERIS_BROKER_RPM_GROQ=30
ERIS_BROKER_TPM_GROQ=6000
ERIS_BROKER_ITPM_GROQ=5000
ERIS_BROKER_OTPM_GROQ=1200
ERIS_BROKER_CONCURRENCY_GROQ=2

ERIS_VISION_FACTS_INTERVAL=45
ERIS_VISION_SCREEN_DELTA_THRESHOLD=0.15
ERIS_PRIVATE_MIND_MIN_INTERVAL_SEC=45
ERIS_PRIVATE_MIND_IDLE_CONSOLIDATION_SEC=240
ERIS_POST_OBSERVER_DEADLINE_SEC=4
ERIS_TUTOR_TOPIC_COOLDOWN_SEC=180
ERIS_TUTOR_DISTILL_TOPIC_COOLDOWN_SEC=300
