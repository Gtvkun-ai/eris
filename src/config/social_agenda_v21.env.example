# Eris social agenda V21: production-safe starting point.
# Start in shadow. Human beings have already invented enough ways to let a
# conversational feature acquire microphone rights before anyone measures it.
ERIS_SOCIAL_EXPERIMENT=social_agenda_v21
ERIS_SOCIAL_ROLLOUT_MODE=shadow
ERIS_SOCIAL_ROLLOUT_RATE=1.0
ERIS_SOCIAL_VARIANT_WEIGHTS=control:25,afterbeat:25,exposure:25,full:25
# Optional for a controlled canary: control | afterbeat | exposure | full
ERIS_SOCIAL_FORCE_VARIANT=

# Durable compare-and-swap state for afterbeat, social exposure, arc and agenda.
ERIS_SOCIAL_ATOMIC_BACKEND=sqlite
ERIS_SOCIAL_ATOMIC_DB=memory/eris_social_runtime.sqlite3

# Reuse committed public-turn results across retries/workers.
ERIS_DURABLE_PUBLIC_TURNS=1

# Cross-session social memory remains opt-in until consent/retention controls exist.
ERIS_SOCIAL_AGENDA_CROSS_SESSION=0

# Existing initiative gates. Tune only after baseline telemetry is collected.
ERIS_SOCIAL_INITIATIVE_SOFT_SILENCE_SEC=180
ERIS_SOCIAL_INITIATIVE_HARD_SILENCE_SEC=600
ERIS_SOCIAL_INITIATIVE_PROBE_INTERVAL_SEC=45
