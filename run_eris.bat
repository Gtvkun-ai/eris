@echo off
REM [FULLBUILD] VENV_PATCH -- auto-generated by _fullbuild.py, DO NOT EDIT
REM Python (repo source -- patched on build)
set "VENV_PY="
set "PATH=%PATH%"
set "WEBAI_BAT="
setlocal enabledelayedexpansion
chcp 65001 >nul
title Eris Launcher

cd /d "%~dp0"

echo.
echo  ╔══════════════════════════════════════════╗
echo  ║           ERIS - AUTO LAUNCHER           ║
echo  ╚══════════════════════════════════════════╝
echo.

:: ── Tìm Python (ưu tiên: VENV_PY từ fullbuild → .venv local → system) ─────────
if defined VENV_PY (
    if exist "%VENV_PY%" (
        set "PYTHON=%VENV_PY%"
        goto PYTHON_FOUND
    )
)
set "PYTHON=%~dp0.venv\Scripts\python.exe"
if not exist "%PYTHON%" (
    echo [WARN] .venv not found, falling back to system python
    set "PYTHON=python"
)
:PYTHON_FOUND

:: ── Bước 1: Kiểm tra / Khởi động WebAI-to-API (cổng 8081) ─────────────────
echo [STEP 1/3] Checking WebAI-to-API on port 8081...

netstat -ano | find "LISTENING" | find ":8081" >nul 2>&1
if %ERRORLEVEL% == 0 (
    echo [OK]   WebAI-to-API already running on :8081
    goto START_ERIS
)

echo [INFO]  Port 8081 not active -- starting WebAI-to-API...

:: Resolve WEBAI_BAT: fullbuild inject > local tools/
if defined WEBAI_BAT (
    if exist "%WEBAI_BAT%" goto USE_WEBAI_BAT
)
set "WEBAI_BAT=%~dp0tools\WebAI-to-API\..\..\run_gemini_web2api.bat"
if not exist "%WEBAI_BAT%" (
    set "WEBAI_BAT=%~dp0run_gemini_web2api.bat"
)
:USE_WEBAI_BAT
if not exist "%WEBAI_BAT%" (
    echo [ERROR] Khong tim thay run_gemini_web2api.bat!
    echo         Path thu: %WEBAI_BAT%
    pause
    exit /b 1
)

start "Eris | WebAI-to-API :8081" cmd /k "call "%WEBAI_BAT%""

echo [INFO]  WebAI-to-API window opened. Waiting for it to start...

:: ── Bước 2: Chờ server 8081 sẵn sàng (tối đa 30 giây) ──────────────────────
echo [STEP 2/3] Waiting for server to be ready (max 30s)...
set /a RETRIES=0
:WAIT_LOOP
    timeout /t 2 /nobreak >nul
    curl -s --max-time 2 http://localhost:8081/v1/models >nul 2>&1
    if %ERRORLEVEL% == 0 goto SERVER_READY
    set /a RETRIES+=1
    if !RETRIES! geq 15 goto SERVER_TIMEOUT
    echo [INFO]  Still waiting... (!RETRIES!/15)
    goto WAIT_LOOP

:SERVER_TIMEOUT
echo.
echo [WARN] Server at :8081 did not respond after 30s.
echo        Eris sẽ vẫn được khởi động — server có thể đang load chậm.
echo.
goto START_ERIS

:SERVER_READY
echo [OK]   WebAI-to-API server is UP at http://localhost:8081
echo.

:: ── Bước 3: Khởi động Eris Runtime ─────────────────────────────────────────
:START_ERIS
echo [STEP 3/3] Starting Eris Runtime...

set "RUNTIME=%~dp0src\vision.py"
if not exist "%RUNTIME%" (
    echo [ERROR] Eris runtime not found at: %RUNTIME%
    pause
    exit /b 1
)

start "Eris | Runtime" cmd /k "chcp 65001 >nul && set PYTHONUTF8=1 && set PYTHONIOENCODING=utf-8 && set PLAYWRIGHT_BROWSERS_PATH=0 && cd /d "%~dp0" && "%PYTHON%" src\vision.py"

echo.
echo  ✔  Tất cả đã khởi động!
echo.
echo  ┌─────────────────────────────────────────┐
echo  │  WebAI-to-API  →  http://localhost:8081  │
echo  │  WebAI UI      →  http://localhost:8081/ui│
echo  │  Eris Runtime  →  cửa sổ riêng           │
echo  └─────────────────────────────────────────┘
echo.
echo  Nhấn bất kỳ phím nào để đóng launcher này...
echo  (Các cửa sổ Eris và WebAI vẫn tiếp tục chạy)
echo.

:: Mở WebUI trong browser
start "" http://localhost:8081/ui

pause >nul
