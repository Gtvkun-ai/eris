{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Eris: Full Build",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe _fullbuild.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
