# Copy to .env for local runtime settings. Do not put real keys in this file.

# Remote cognition API
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=gemini
ERIS_REMOTE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ERIS_REMOTE_MODEL=
ERIS_REMOTE_API_KEY=
GEMINI_API_KEY=

# Optional local cognition helpers
ERIS_LOCAL_STYLE_REWRITE_ENABLED=0
ERIS_LOCAL_VISION_FACTS=0
ERIS_VISION_FACTS=1
ERIS_VISION_FACTS_INTERVAL=60
ERIS_VISION_FACTS_MAX=3
ERIS_VISION_FACTS_MAX_LEN=120

# ── LOCAL LLAMA-CPP ENGINE (đọc gguf trong src/, không cần Ollama) ───────────
# Đặt llamacpp để dùng engine local; để trống hoặc ollama để fallback Ollama.
# Tắt local engine (máy không GPU) — không nạp/chạy gguf trên CPU.
ERIS_LOCAL_LLM_ENGINE=
ERIS_LLAMACPP_N_CTX=8192
# -1 = đẩy hết layer lên GPU (CUDA); 0 = CPU-only (chậm nhưng không cần GPU)
ERIS_LLAMACPP_N_GPU_LAYERS=0
ERIS_LLAMACPP_TEXT_MODEL=src/qwen3-1.7b-q4_k_m.gguf
ERIS_LLAMACPP_VISION_MODEL=src/moondream2-q4_k.gguf
ERIS_LLAMACPP_VISION_MMPROJ=src/moondream2-mmproj-f16.gguf
# Vision = 2 tầng (moondream caption → text model cấu trúc hoá). GPU layers vision
# tách khỏi text; trên GPU nhỏ để 0 cho vision chạy CPU, tránh OOM khi load.
ERIS_LLAMACPP_VISION_N_GPU_LAYERS=0
ERIS_VISION_STRUCTURE_MODEL=

# Private mind (fragment + judgment + diary) — dùng remote Gemini (không local)
ERIS_PRIVATE_MIND_API_ENABLED=1
ERIS_PRIVATE_MIND_PROVIDER=gemini
ERIS_PRIVATE_MIND_MODEL=
ERIS_PRIVATE_MIND_FRAGMENT_PROVIDER=gemini
ERIS_PRIVATE_MIND_FRAGMENT_MODEL=
ERIS_PRIVATE_MIND_FRAGMENT_FREETEXT=1
# ─────────────────────────────────────────────────────────────────────────────

# Background observer rollout
# Phase 1: keep LLM off first
ERIS_BACKGROUND_OBSERVER=1
ERIS_BACKGROUND_OBSERVER_LLM=0
ERIS_OBSERVER_MODEL=qwen3:0.6b
ERIS_OBSERVER_KEEP_ALIVE=30m
ERIS_OBSERVER_LLM_MIN_DIFF=0.18
ERIS_OBSERVER_LLM_COOLDOWN=8

# Ollama vision compressor rollout
# Suggested local model: moondream (~1.9B, ~2GB VRAM, fast)
# Pull: ollama pull moondream
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_TIMEOUT_SEC=60
ERIS_VISION_COMPRESSOR=0
ERIS_VISION_COMPRESSOR_MODEL=moondream
ERIS_VISION_KEEP_ALIVE=0
ERIS_VISION_TEMPERATURE=0
ERIS_VISION_MIN_SALIENCE=0.70
ERIS_VISION_MIN_DIFF=0.20
ERIS_VISION_MAX_OCR_CHARS=1600
ERIS_VISION_UNLOAD_AFTER_CALL=1

# Runtime cadence and guardrails
ERIS_GUARD_MODE=log_only

# Novelty post-generation (chống lặp theo NGHĨA ở cửa ra câu nói)
# Mode: off | log | enforce
#   log     = chỉ ghi điểm novelty vào debug_trace, không đổi câu
#   enforce = câu nghi đơn điệu bị hạ confidence; gần như lặp y hệt + không phải
#             chat → im (body_only). Chat không bao giờ bị mute.
# Threshold: dưới mức này coi là "nghi lặp" (0..0.9).
ERIS_NOVELTY_POSTGEN_MODE=enforce
ERIS_NOVELTY_POSTGEN_THRESHOLD=0.18

# Voice-seed pipeline (register-default anti-disclaimer)
# Scope: off | relational | social (default) | always
#   off        = disabled; only the A–D disclaimer net runs
#   relational = legacy narrow relational-act whitelist only
#   social     = seed-first for the whole social register; task/code turns exempt
#   always     = every chat turn (experimental; doubles calls on technical turns)
ERIS_VOICE_SEED_SCOPE=social
ERIS_RELATIONAL_VOICE_SEED_ENABLED=1
ERIS_RELATIONAL_VOICE_SEED_MAX_TOKENS=64
ERIS_RELATIONAL_VOICE_SEED_TIMEOUT_MS=4000
ERIS_RELATIONAL_VOICE_SEED_CONT_MAX_TOKENS=80
ERIS_RELATIONAL_VOICE_SEED_CONT_TIMEOUT_MS=6000

ERIS_NI_META_CRITIC=1
ERIS_MENTAL_PROCESS_LOOP=1
ERIS_MENTAL_PROCESS_INTERVAL_SEC=30
ERIS_THOUGHT_STREAM_LOOP=1
ERIS_THOUGHT_STREAM_INTERVAL_SEC=45
ERIS_AUTONOMOUS_SLEEP_SEC=30,45,60,90
ERIS_AUTONOMOUS_SUPPRESSED_SLEEP_SEC=45,60,90,120

# Autonomous-liveliness redesign — keep idle presence alive, not frozen.
# All readers clamp to range + fall back to default on bad input (never raise).
ERIS_LIVELINESS_VISION_FRESH_SEC=30        # vision fact must be this fresh to seed a line
ERIS_LIVELINESS_SEED_MAX_LEN=240           # max length of a retained memory/inner seed
ERIS_LIVELINESS_REPEAT_WINDOW_SEC=180      # exact-repeat window (>= 120s max idle interval)
ERIS_LIVELINESS_SIM_THRESHOLD_PCT=78       # same-family similarity reject threshold (0-100)
ERIS_LIVELINESS_MAX_LINE_REPEAT=3          # max repeats of one line per 60-min window
ERIS_LIVELINESS_MAX_ALT_SEEDS=3            # alt-seed retries when a winner repeats last line
# Body-only presence on an ambient-silence hold: shift/observe at most once per gap
# (a frozen sprite reads as dead; set 0 to allow a body shift every held cycle).
ERIS_LIVELINESS_BODY_ONLY_MIN_GAP_SEC=90

# Presence / micro-presence
ERIS_PRESENCE_MAINTENANCE=1
ERIS_PRESENCE_MAINTENANCE_SILENT_LOOPS=1
ERIS_PRESENCE_MAINTENANCE_COOLDOWN_SEC=12
ERIS_MICRO_PRESENCE_LLM=1
ERIS_MICRO_PRESENCE_LLM_PROBABILITY=0.85
ERIS_REENGAGEMENT=1
ERIS_REENGAGEMENT_QUIET_LOOPS=1
ERIS_REENGAGEMENT_MIN_IDLE_SEC=45
ERIS_REENGAGEMENT_COOLDOWN_SEC=45

# Private mind loop — performance tuning
# Timeout thấp hơn để fail-fast thay vì đợi 28s trước khi retry
ERIS_PRIVATE_MIND_TIMEOUT=12
# Token giới hạn nhỏ hơn giúp Gemini trả lời nhanh hơn
ERIS_PRIVATE_MIND_FRAGMENT_TOKENS=320
ERIS_PRIVATE_MIND_JUDGMENT_TOKENS=384

# Epistemic Architecture V2
# V2 starts from an empty belief store and treats V1 cognition files as a
# read-only legacy archive. During shadow rollout it records recommendations
# and learns from next-turn feedback without replacing the public output path.
ERIS_EPISTEMIC_V2_ENABLED=1
ERIS_EPISTEMIC_V2_MODE=authoritative
ERIS_EPISTEMIC_V2_PATH=memory_core/epistemic_v2.json

# ─────────────────────────────────────────────────────────────────────────────
# LLM RELIABILITY — Phase 0/1/4 + DDS (sửa 413/500, key-pool, distillation)
# ─────────────────────────────────────────────────────────────────────────────
# Phase 0 — Hard-cap token cho MỌI call remote. Nếu prompt vượt cap → tự cắt
# history cũ (giữ system + lượt cuối) trước khi gửi → chặn 413 tức thì.
# Để trống = auto 85% TPM provider (Groq ~5100). Đặt số cụ thể để ép chặt hơn.
ERIS_LLM_PROMPT_HARD_CAP_TOKENS=
# Mức reasoning cho model có "thinking" (qwen3/gpt-oss). none = khỏi đốt token.
ERIS_REASONING_EFFORT=none

# Phase 1 — Timeout synthesis/judgment (nặng) tách riêng fragment (nhẹ).
# Fragment vẫn fail-fast bằng ERIS_PRIVATE_MIND_TIMEOUT (12s).
ERIS_PRIVATE_MIND_SYNTHESIS_TIMEOUT=20

# Phase 4 — Key-pool: trần đồng thời per-provider (worker DDS chạy song song).
ERIS_LLM_MAX_CONCURRENCY=4
# Override theo provider (tùy chọn): ERIS_LLM_GEMINI_MAX_CONCURRENCY / *_GROQ_*
#ERIS_LLM_GEMINI_MAX_CONCURRENCY=4
#ERIS_LLM_GROQ_MAX_CONCURRENCY=2
# Key dự phòng dạng danh sách (phân tách bằng dấu phẩy). Bổ sung cho secrets.json.
#ERIS_GROQ_FALLBACK_API_KEYS=key1,key2
#ERIS_PRIVATE_MIND_FALLBACK_API_KEYS=key1,key2
#ERIS_GEMINI_FALLBACK_API_KEYS=key1,key2

# Phase 2/3 — DDS (Decompose→Distill→Synthesize). Khi ngữ cảnh nặng vượt ngưỡng,
# băm + rút gọn các khối lớn (memory/conversation/grounding/ni/ti) SONG SONG bằng
# worker nhỏ trước khi đưa vào synthesis. Turn nhỏ KHÔNG bị ảnh hưởng.
ERIS_DDS_ENABLED=1
# Ngưỡng kích hoạt (token ước lượng của ngữ cảnh nặng). Để trống = 60% hard-cap.
ERIS_DDS_TRIGGER_TOKENS=

# Test-only: tắt loader .env để cô lập test (runtime thật KHÔNG đặt biến này).
#ERIS_DISABLE_DOTENV=1

# ── CURIOSITY TUTOR (gia sư web — tự động hóa gemini.google.com) ─────────────
# Master_Switch: mặc định TẮT. Chỉ bật khi đã đăng nhập Google vào profile_dir bằng tay.
# CẢNH BÁO: tự động hóa tài khoản Google tiêu dùng vi phạm ToS của Google và tài khoản
# CÓ THỂ bị khóa. Cửa sổ trình duyệt thật có thể lộ email/tab khác trên màn hình.
ERIS_TUTOR_ENABLED=0
# Thư mục hồ sơ Chromium bền vững (đăng nhập Google một lần vào đây bằng tay).
ERIS_TUTOR_PROFILE_DIR=
ERIS_TUTOR_NAV_URL=https://gemini.google.com
# Cổng tò mò
ERIS_TUTOR_CURIOSITY_THRESHOLD=0.5
ERIS_TUTOR_MIN_GAP_SECONDS=120
ERIS_TUTOR_MAX_PER_HOUR=20
ERIS_TUTOR_OBSERVER_AMBIGUITY=0.6
ERIS_TUTOR_MAX_GAP_QUEUE=50
# Backend web
ERIS_TUTOR_EPISODE_TIMEOUT=90
ERIS_TUTOR_ANSWER_STABLE_WINDOW=2.5
ERIS_TUTOR_WINDOW_WIDTH=520
ERIS_TUTOR_WINDOW_HEIGHT=720
# Selector trang (chỉnh khi Gemini đổi UI)
# ERIS_TUTOR_SEL_INPUT=
# ERIS_TUTOR_SEL_SEND=
# ERIS_TUTOR_SEL_RESPONSE=
# Khoe điều mới học
ERIS_TUTOR_SHARE_WINDOW=600
ERIS_TUTOR_SHARE_NOVELTY=0.5
# Model local sinh câu hỏi (engine local/ollama)
ERIS_TUTOR_LOCAL_MODEL=qwen3:1.7b

# ── NƯỚC 1 — VAN BƯỚC-CUỐI (emotional consequence) ──────────────────────────
# Biến affect/biểu đạt từ "gợi ý in vào prompt" thành HỆ QUẢ CƠ HỌC lên câu nói.
# Khi BẬT (1):
#   - appraisal bỏ disclaimer "không phải cảm xúc thật" → cho stance lộ ra;
#   - personality gỡ blacklist *từ vựng cảm xúc* (vẫn giữ ban claim màn hình/quan sát);
#   - nếu câu cuối bị bóp phẳng dưới mức biểu đạt thật (allowed_expression cao mà
#     câu lại cụt) → xin reroll felt-expansion MỘT lần. Van chỉ MỞ, không bao giờ
#     làm Eris câm hay rút ngắn; reroll lỗi/ngắn hơn → giữ nguyên bản gốc.
# MẶC ĐỊNH TẮT (đảo ngược được). Chỉ tác động kênh chat/force_speak.
ERIS_EMOTIONAL_CONSEQUENCE=0

# ── NƯỚC 2 — TÍCH LŨY / LIÊN TỤC BẢN THÂN (developmental growth) ────────────
# Bật động cơ long-arc: persona lệch dần theo bằng chứng thật (warmth/distance/
# read-boldness/attachment-visibility), trong Phong_Bì_Bản_Sắc (INFJ 5w4 594 là
# baseline bất biến). Khi BẬT, Eris còn tự kể "so với lúc đầu, tôi đã..." nhuộm
# vào self-narrative + prompt nói (không đọc ra như báo cáo). MẶC ĐỊNH TẮT.
ERIS_DEVELOPMENT_GROWTH_ENABLED=0
# (tùy chọn) ép đường file profile long-arc; để trống = memory_core/development_profile.json
# ERIS_DEVELOPMENT_PROFILE_PATH=

# ── NƯỚC 3(c) — ĐƯỜNG SURFACE KHÔNG-ANCHOR CÓ-CỔNG (interiority) ─────────────
# Cho một bận tâm nội tâm áp lực CAO nổi lên public dù thiếu anchor ngoài — khoảnh
# khắc "tôi đã ngồi với điều này". Van vẫn siết: chỉ qua khi mới, ít lặp, không
# filler, API khỏe, áp lực vượt ngưỡng. MẶC ĐỊNH TẮT (cố ý hiếm, không phải cửa xả).
ERIS_INTERIOR_SURFACE_NONANCHORED=0
ERIS_INTERIOR_SURFACE_PRESSURE=0.80

# ── NƯỚC 3(d) — BẬT MODEL NỀN CHO NỘI TÂM (thôi lặp template) ───────────────
# Để nội tâm (fragment/judgment/diary) do MODEL sinh thay vì deterministic fallback
# (vốn lặp "Mà"/"Với lại"). Đặt =1 và chọn provider phù hợp ở khối "Private mind"
# phía trên. Tốn quota/độ trễ; bật khi muốn nội dung nội tâm thật sự tiến hóa.
#   ERIS_PRIVATE_MIND_API_ENABLED=1

# ── NƯỚC 3(a)+(b) — CẮM ToM PIPELINE VÀO RESPONSE PATH (thấu hiểu Ngài) ──────
# Chạy Phase2MeaningPipeline (8 tầng: WorldScene→...→TheoryOfMind) với hợp đồng
# đọc ĐÚNG (sửa lỗi downstream_contract khiến pipeline trước đây luôn rỗng), rút
# MentalStateInference đã qua OverreadBrake thành một dòng "tom_read" advisory bơm
# vào prompt nói. Là SUY ĐOÁN hỗ trợ chọn giọng, KHÔNG đọc ra như sự thật. TẮT mặc định.
ERIS_TOM_ADVISOR=0
# (b) Dùng embedding MiniLM thật (paraphrase-multilingual) cho tầng meaning thay
# cho hash fallback. Cần torch/transformers + model trong src/. TẮT mặc định.
ERIS_MEANING_REAL_EMBEDDINGS=0
