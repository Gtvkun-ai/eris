# Copy to .env for local runtime settings. Do not put real keys in this file.

# Remote cognition API
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=gemini
ERIS_REMOTE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ERIS_REMOTE_MODEL=
ERIS_REMOTE_API_KEY=
GEMINI_API_KEY=

# Local GGUF / llama-server
GGUF_MODEL_PATH=
LLAMA_SERVER_EXE=
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_NGL=all
LLAMA_SERVER_FLASH_ATTN=on
LLAMA_SERVER_EXTRA_ARGS=
LLAMA_SERVER_CACHE_RAM=1024
LLAMA_SERVER_MMPROJ=
ERIS_N_CTX=8192

# Optional local cognition helpers
ERIS_LOCAL_STYLE_REWRITE_ENABLED=0
ERIS_LOCAL_VISION_FACTS=1
ERIS_VISION_FACTS=1
ERIS_VISION_FACTS_INTERVAL=60
ERIS_VISION_FACTS_MAX=3
ERIS_VISION_FACTS_MAX_LEN=120

# Background observer rollout
# Phase 1: keep LLM off first
ERIS_BACKGROUND_OBSERVER=1
ERIS_BACKGROUND_OBSERVER_LLM=0
ERIS_OBSERVER_MODEL=qwen3:0.6b
ERIS_OBSERVER_KEEP_ALIVE=30m
ERIS_OBSERVER_LLM_MIN_DIFF=0.18
ERIS_OBSERVER_LLM_COOLDOWN=8

# Ollama vision compressor rollout
# Suggested local model: qwen2.5vl:3b
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_TIMEOUT_SEC=240
ERIS_VISION_COMPRESSOR=0
ERIS_VISION_COMPRESSOR_MODEL=qwen2.5vl:3b
ERIS_VISION_KEEP_ALIVE=0
ERIS_VISION_TEMPERATURE=0
ERIS_VISION_MIN_SALIENCE=0.70
ERIS_VISION_MIN_DIFF=0.20
ERIS_VISION_MAX_OCR_CHARS=1600
ERIS_VISION_UNLOAD_AFTER_CALL=1

# Runtime cadence and guardrails
ERIS_GUARD_MODE=log_only
ERIS_NI_META_CRITIC=1
ERIS_MENTAL_PROCESS_LOOP=1
ERIS_MENTAL_PROCESS_INTERVAL_SEC=30
ERIS_THOUGHT_STREAM_LOOP=1
ERIS_THOUGHT_STREAM_INTERVAL_SEC=45
ERIS_AUTONOMOUS_SLEEP_SEC=30,45,60,90
ERIS_AUTONOMOUS_SUPPRESSED_SLEEP_SEC=45,60,90,120

# Presence / micro-presence
ERIS_PRESENCE_MAINTENANCE=1
ERIS_PRESENCE_MAINTENANCE_SILENT_LOOPS=1
ERIS_PRESENCE_MAINTENANCE_COOLDOWN_SEC=12
ERIS_MICRO_PRESENCE_LLM=1
ERIS_MICRO_PRESENCE_LLM_PROBABILITY=0.85
ERIS_REENGAGEMENT=1
ERIS_REENGAGEMENT_QUIET_LOOPS=1
ERIS_REENGAGEMENT_MIN_IDLE_SEC=45
ERIS_REENGAGEMENT_COOLDOWN_SEC=45
