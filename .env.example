# Copy to .env for local runtime settings. Do not put real keys in this file.

# Remote cognition API
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=gemini
ERIS_REMOTE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ERIS_REMOTE_MODEL=
ERIS_REMOTE_API_KEY=
GEMINI_API_KEY=

# Optional local cognition helpers
ERIS_LOCAL_STYLE_REWRITE_ENABLED=0
ERIS_LOCAL_VISION_FACTS=0
ERIS_VISION_FACTS=1
ERIS_VISION_FACTS_INTERVAL=60
ERIS_VISION_FACTS_MAX=3
ERIS_VISION_FACTS_MAX_LEN=120

# ── LOCAL LLAMA-CPP ENGINE (đọc gguf trong src/, không cần Ollama) ───────────
# Đặt llamacpp để dùng engine local; để trống hoặc ollama để fallback Ollama.
# Tắt local engine (máy không GPU) — không nạp/chạy gguf trên CPU.
ERIS_LOCAL_LLM_ENGINE=
ERIS_LLAMACPP_N_CTX=8192
# -1 = đẩy hết layer lên GPU (CUDA); 0 = CPU-only (chậm nhưng không cần GPU)
ERIS_LLAMACPP_N_GPU_LAYERS=0
ERIS_LLAMACPP_TEXT_MODEL=src/qwen3-1.7b-q4_k_m.gguf
ERIS_LLAMACPP_VISION_MODEL=src/moondream2-q4_k.gguf
ERIS_LLAMACPP_VISION_MMPROJ=src/moondream2-mmproj-f16.gguf

# Private mind (fragment + judgment + diary) — dùng remote Gemini (không local)
ERIS_PRIVATE_MIND_API_ENABLED=1
ERIS_PRIVATE_MIND_PROVIDER=gemini
ERIS_PRIVATE_MIND_MODEL=
ERIS_PRIVATE_MIND_FRAGMENT_PROVIDER=gemini
ERIS_PRIVATE_MIND_FRAGMENT_MODEL=
ERIS_PRIVATE_MIND_FRAGMENT_FREETEXT=1
# ─────────────────────────────────────────────────────────────────────────────

# Background observer rollout
# Phase 1: keep LLM off first
ERIS_BACKGROUND_OBSERVER=1
ERIS_BACKGROUND_OBSERVER_LLM=0
ERIS_OBSERVER_MODEL=qwen3:0.6b
ERIS_OBSERVER_KEEP_ALIVE=30m
ERIS_OBSERVER_LLM_MIN_DIFF=0.18
ERIS_OBSERVER_LLM_COOLDOWN=8

# Ollama vision compressor rollout
# Suggested local model: moondream (~1.9B, ~2GB VRAM, fast)
# Pull: ollama pull moondream
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_TIMEOUT_SEC=60
ERIS_VISION_COMPRESSOR=0
ERIS_VISION_COMPRESSOR_MODEL=moondream
ERIS_VISION_KEEP_ALIVE=0
ERIS_VISION_TEMPERATURE=0
ERIS_VISION_MIN_SALIENCE=0.70
ERIS_VISION_MIN_DIFF=0.20
ERIS_VISION_MAX_OCR_CHARS=1600
ERIS_VISION_UNLOAD_AFTER_CALL=1

# Runtime cadence and guardrails
ERIS_GUARD_MODE=log_only

# Novelty post-generation (chống lặp theo NGHĨA ở cửa ra câu nói)
# Mode: off | log | enforce
#   log     = chỉ ghi điểm novelty vào debug_trace, không đổi câu
#   enforce = câu nghi đơn điệu bị hạ confidence; gần như lặp y hệt + không phải
#             chat → im (body_only). Chat không bao giờ bị mute.
# Threshold: dưới mức này coi là "nghi lặp" (0..0.9).
ERIS_NOVELTY_POSTGEN_MODE=enforce
ERIS_NOVELTY_POSTGEN_THRESHOLD=0.18

# Voice-seed pipeline (register-default anti-disclaimer)
# Scope: off | relational | social (default) | always
#   off        = disabled; only the A–D disclaimer net runs
#   relational = legacy narrow relational-act whitelist only
#   social     = seed-first for the whole social register; task/code turns exempt
#   always     = every chat turn (experimental; doubles calls on technical turns)
ERIS_VOICE_SEED_SCOPE=social
ERIS_RELATIONAL_VOICE_SEED_ENABLED=1
ERIS_RELATIONAL_VOICE_SEED_MAX_TOKENS=64
ERIS_RELATIONAL_VOICE_SEED_TIMEOUT_MS=4000
ERIS_RELATIONAL_VOICE_SEED_CONT_MAX_TOKENS=80
ERIS_RELATIONAL_VOICE_SEED_CONT_TIMEOUT_MS=6000

ERIS_NI_META_CRITIC=1
ERIS_MENTAL_PROCESS_LOOP=1
ERIS_MENTAL_PROCESS_INTERVAL_SEC=30
ERIS_THOUGHT_STREAM_LOOP=1
ERIS_THOUGHT_STREAM_INTERVAL_SEC=45
ERIS_AUTONOMOUS_SLEEP_SEC=30,45,60,90
ERIS_AUTONOMOUS_SUPPRESSED_SLEEP_SEC=45,60,90,120

# Autonomous-liveliness redesign — keep idle presence alive, not frozen.
# All readers clamp to range + fall back to default on bad input (never raise).
ERIS_LIVELINESS_VISION_FRESH_SEC=30        # vision fact must be this fresh to seed a line
ERIS_LIVELINESS_SEED_MAX_LEN=240           # max length of a retained memory/inner seed
ERIS_LIVELINESS_REPEAT_WINDOW_SEC=180      # exact-repeat window (>= 120s max idle interval)
ERIS_LIVELINESS_SIM_THRESHOLD_PCT=78       # same-family similarity reject threshold (0-100)
ERIS_LIVELINESS_MAX_LINE_REPEAT=3          # max repeats of one line per 60-min window
ERIS_LIVELINESS_MAX_ALT_SEEDS=3            # alt-seed retries when a winner repeats last line
# Body-only presence on an ambient-silence hold: shift/observe at most once per gap
# (a frozen sprite reads as dead; set 0 to allow a body shift every held cycle).
ERIS_LIVELINESS_BODY_ONLY_MIN_GAP_SEC=90

# Presence / micro-presence
ERIS_PRESENCE_MAINTENANCE=1
ERIS_PRESENCE_MAINTENANCE_SILENT_LOOPS=1
ERIS_PRESENCE_MAINTENANCE_COOLDOWN_SEC=12
ERIS_MICRO_PRESENCE_LLM=1
ERIS_MICRO_PRESENCE_LLM_PROBABILITY=0.85
ERIS_REENGAGEMENT=1
ERIS_REENGAGEMENT_QUIET_LOOPS=1
ERIS_REENGAGEMENT_MIN_IDLE_SEC=45
ERIS_REENGAGEMENT_COOLDOWN_SEC=45

# Private mind loop — performance tuning
# Timeout thấp hơn để fail-fast thay vì đợi 28s trước khi retry
ERIS_PRIVATE_MIND_TIMEOUT=12
# Token giới hạn nhỏ hơn giúp Gemini trả lời nhanh hơn
ERIS_PRIVATE_MIND_FRAGMENT_TOKENS=320
ERIS_PRIVATE_MIND_JUDGMENT_TOKENS=384

# Epistemic Architecture V2
# V2 starts from an empty belief store and treats V1 cognition files as a
# read-only legacy archive. During shadow rollout it records recommendations
# and learns from next-turn feedback without replacing the public output path.
ERIS_EPISTEMIC_V2_ENABLED=1
ERIS_EPISTEMIC_V2_MODE=authoritative
ERIS_EPISTEMIC_V2_PATH=memory_core/epistemic_v2.json
