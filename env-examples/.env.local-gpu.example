# ════════════════════════════════════════════════════════════════════════════
# PRESET: LOCAL-GPU  (máy có GPU rời, ví dụ ≥6GB VRAM)
# ────────────────────────────────────────────────────────────────────────────
# Chạy FULL local qua llama-cpp-python (đọc gguf thẳng từ src/, không cần Ollama).
# Remote chỉ dùng Gemini cho judgment/diary khi cần. Đây là cấu hình nhanh + riêng tư
# nhất nếu máy đủ VRAM. OOM "Failed to load model" -> hạ *_N_GPU_LAYERS.
# Copy file này -> .env rồi điền GEMINI_API_KEY.
# ════════════════════════════════════════════════════════════════════════════

# Remote cognition API (judgment/diary + fallback chat)
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=gemini
ERIS_REMOTE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ERIS_REMOTE_MODEL=
ERIS_REMOTE_API_KEY=
GEMINI_API_KEY=

# ── LOCAL LLAMA-CPP ENGINE (GPU) ─────────────────────────────────────────────
ERIS_LOCAL_LLM_ENGINE=llamacpp
ERIS_LLAMACPP_ENABLED=1
ERIS_LLAMACPP_N_CTX=4096
# -1 = đẩy hết layer text lên GPU
ERIS_LLAMACPP_N_GPU_LAYERS=-1
ERIS_LLAMACPP_TEXT_MODEL=src/qwen3-1.7b-q4_k_m.gguf
ERIS_LLAMACPP_VISION_MODEL=src/moondream2-q4_k.gguf
ERIS_LLAMACPP_VISION_MMPROJ=src/moondream2-mmproj-f16.gguf
# Vision GPU layers TÁCH RIÊNG khỏi text. Card 4GB -> 0 (vision CPU) để text giữ GPU.
# Card lớn hơn -> nâng 16/20/24/-1 cho caption nhanh.
ERIS_LLAMACPP_VISION_N_GPU_LAYERS=16
ERIS_LLAMACPP_VISION_MAX_TOKENS=200
ERIS_VISION_STRUCTURE_MODEL=

# Private mind chạy LOCAL (fragment free-text + judgment/diary ép grammar JSON)
ERIS_PRIVATE_MIND_API_ENABLED=1
ERIS_PRIVATE_MIND_PROVIDER=llamacpp
ERIS_PRIVATE_MIND_MODEL=src/qwen3-1.7b-q4_k_m.gguf
ERIS_PRIVATE_MIND_FRAGMENT_PROVIDER=llamacpp
ERIS_PRIVATE_MIND_FRAGMENT_MODEL=src/qwen3-1.7b-q4_k_m.gguf
ERIS_PRIVATE_MIND_FRAGMENT_FREETEXT=1

# Optional local cognition helpers
ERIS_LOCAL_STYLE_REWRITE_ENABLED=0
ERIS_LOCAL_VISION_FACTS=0
ERIS_VISION_FACTS=1
ERIS_VISION_FACTS_INTERVAL=10
ERIS_VISION_FACTS_MAX=3
ERIS_VISION_FACTS_MAX_LEN=120

# Background observer (LLM bật vì local rẻ)
ERIS_BACKGROUND_OBSERVER=1
ERIS_BACKGROUND_OBSERVER_LLM=1
ERIS_OBSERVER_MODEL=qwen3:0.6b
ERIS_OBSERVER_KEEP_ALIVE=30m
ERIS_OBSERVER_LLM_MIN_DIFF=0.18
ERIS_OBSERVER_LLM_COOLDOWN=8

# Embedding model cho memory recall
ERIS_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ERIS_EMBEDDING_CACHE_DIR=src/paraphrase-multilingual-MiniLM-L12-v2
ERIS_MEANING_REAL_EMBEDDINGS=1

# Runtime cadence & guardrails
ERIS_GUARD_MODE=log_only
ERIS_NOVELTY_POSTGEN_MODE=enforce
ERIS_NOVELTY_POSTGEN_THRESHOLD=0.18
ERIS_REASONING_EFFORT=none

# Depth features (bật full)
ERIS_EMOTIONAL_CONSEQUENCE=1
ERIS_DEVELOPMENT_GROWTH_ENABLED=1
ERIS_INTERIOR_SURFACE_NONANCHORED=1
ERIS_INTERIOR_SURFACE_PRESSURE=0.80
ERIS_TOM_ADVISOR=1
