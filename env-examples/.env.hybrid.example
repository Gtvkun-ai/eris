# ════════════════════════════════════════════════════════════════════════════
# PRESET: HYBRID  (GPU nhỏ ~4GB — vd GTX 1650 / laptop GPU)
# ────────────────────────────────────────────────────────────────────────────
# Fragment + text local trên GPU (rẻ, riêng tư); judgment/diary nặng đẩy lên
# Gemini để khỏi OOM. Vision chạy CPU để chừa VRAM cho text. Cân bằng tốc độ/quota.
# Copy -> .env, điền GEMINI_API_KEY.
# ════════════════════════════════════════════════════════════════════════════

# Remote cognition API (judgment/diary nặng + fallback)
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=gemini
ERIS_REMOTE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ERIS_REMOTE_MODEL=
ERIS_REMOTE_API_KEY=
GEMINI_API_KEY=

# ── LOCAL LLAMA-CPP ENGINE (GPU nhỏ) ─────────────────────────────────────────
ERIS_LOCAL_LLM_ENGINE=llamacpp
ERIS_LLAMACPP_ENABLED=1
ERIS_LLAMACPP_N_CTX=4096
# Text giữ GPU
ERIS_LLAMACPP_N_GPU_LAYERS=-1
ERIS_LLAMACPP_TEXT_MODEL=src/qwen3-1.7b-q4_k_m.gguf
ERIS_LLAMACPP_VISION_MODEL=src/moondream2-q4_k.gguf
ERIS_LLAMACPP_VISION_MMPROJ=src/moondream2-mmproj-f16.gguf
# Vision CPU (0) trên 4GB để tránh OOM khi peak text+vision
ERIS_LLAMACPP_VISION_N_GPU_LAYERS=0
ERIS_LLAMACPP_VISION_MAX_TOKENS=200
ERIS_VISION_STRUCTURE_MODEL=

# Private mind: FRAGMENT local (rẻ), JUDGMENT/DIARY remote Gemini (nặng)
ERIS_PRIVATE_MIND_API_ENABLED=1
ERIS_PRIVATE_MIND_FRAGMENT_PROVIDER=llamacpp
ERIS_PRIVATE_MIND_FRAGMENT_MODEL=src/qwen3-1.7b-q4_k_m.gguf
ERIS_PRIVATE_MIND_FRAGMENT_FREETEXT=1
ERIS_PRIVATE_MIND_PROVIDER=gemini
ERIS_PRIVATE_MIND_MODEL=
ERIS_PRIVATE_MIND_TIMEOUT=12
ERIS_PRIVATE_MIND_SYNTHESIS_TIMEOUT=20

# Vision facts: bật, giãn interval để đỡ giữ GPU lock
ERIS_VISION_FACTS=1
ERIS_VISION_FACTS_INTERVAL=30
ERIS_VISION_FACTS_MAX=3
ERIS_VISION_FACTS_MAX_LEN=120
ERIS_VISION_UNLOAD_AFTER_CALL=1

# Background observer: LLM tắt (đỡ tranh GPU với chat)
ERIS_BACKGROUND_OBSERVER=1
ERIS_BACKGROUND_OBSERVER_LLM=0

# Toc do: chỉ 2 fragment evaluator/tick để chu kỳ ngắn
ERIS_PRIVATE_MIND_EVALUATORS=intent_evaluator,memory_resonance_evaluator

# Embedding
ERIS_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ERIS_EMBEDDING_CACHE_DIR=src/paraphrase-multilingual-MiniLM-L12-v2
ERIS_MEANING_REAL_EMBEDDINGS=1

# Runtime cadence & guardrails
ERIS_GUARD_MODE=log_only
ERIS_NOVELTY_POSTGEN_MODE=enforce
ERIS_NOVELTY_POSTGEN_THRESHOLD=0.18
ERIS_REASONING_EFFORT=none

# Depth features: bật vừa phải
ERIS_EMOTIONAL_CONSEQUENCE=1
ERIS_DEVELOPMENT_GROWTH_ENABLED=1
ERIS_INTERIOR_SURFACE_NONANCHORED=0
ERIS_TOM_ADVISOR=0
