# ════════════════════════════════════════════════════════════════════════════
# PRESET: OLLAMA  (chạy model local qua server Ollama thay vì llama-cpp in-process)
# ────────────────────────────────────────────────────────────────────────────
# Dùng khi đã có Ollama cài sẵn và muốn quản model qua đó. Cần chạy `ollama serve`
# và pull model trước:
#   ollama pull qwen3:1.7b
#   ollama pull qwen3:0.6b
#   ollama pull moondream
# Copy -> .env, điền GEMINI_API_KEY (dùng cho judgment/diary remote nếu cần).
# ════════════════════════════════════════════════════════════════════════════

# Remote cognition API (judgment/diary + fallback)
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=gemini
ERIS_REMOTE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ERIS_REMOTE_MODEL=
ERIS_REMOTE_API_KEY=
GEMINI_API_KEY=

# ── LOCAL ENGINE = OLLAMA ────────────────────────────────────────────────────
ERIS_LOCAL_LLM_ENGINE=ollama
ERIS_LLAMACPP_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SEC=60

# Vision compressor qua Ollama (moondream)
ERIS_VISION_COMPRESSOR=1
ERIS_VISION_COMPRESSOR_MODEL=moondream
ERIS_VISION_KEEP_ALIVE=0
ERIS_VISION_TEMPERATURE=0
ERIS_VISION_MIN_SALIENCE=0.70
ERIS_VISION_MIN_DIFF=0.20
ERIS_VISION_MAX_OCR_CHARS=1600
ERIS_VISION_UNLOAD_AFTER_CALL=1
# Tầng cấu trúc hoá caption (để trống = text model của engine)
ERIS_VISION_STRUCTURE_MODEL=qwen3:1.7b
ERIS_VISION_FACTS=1
ERIS_VISION_FACTS_INTERVAL=30

# Private mind: fragment local qua Ollama, judgment/diary remote Gemini
ERIS_PRIVATE_MIND_API_ENABLED=1
ERIS_PRIVATE_MIND_FRAGMENT_PROVIDER=ollama
ERIS_PRIVATE_MIND_FRAGMENT_MODEL=qwen3:1.7b
ERIS_PRIVATE_MIND_FRAGMENT_FREETEXT=1
ERIS_PRIVATE_MIND_PROVIDER=gemini
ERIS_PRIVATE_MIND_MODEL=
ERIS_PRIVATE_MIND_TIMEOUT=12
ERIS_PRIVATE_MIND_SYNTHESIS_TIMEOUT=20

# Background observer qua Ollama
ERIS_BACKGROUND_OBSERVER=1
ERIS_BACKGROUND_OBSERVER_LLM=1
ERIS_OBSERVER_MODEL=qwen3:0.6b
ERIS_OBSERVER_KEEP_ALIVE=30m
ERIS_OBSERVER_LLM_MIN_DIFF=0.18
ERIS_OBSERVER_LLM_COOLDOWN=8

# Embedding
ERIS_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ERIS_EMBEDDING_CACHE_DIR=src/paraphrase-multilingual-MiniLM-L12-v2
ERIS_MEANING_REAL_EMBEDDINGS=1

# Runtime cadence & guardrails
ERIS_GUARD_MODE=log_only
ERIS_NOVELTY_POSTGEN_MODE=enforce
ERIS_NOVELTY_POSTGEN_THRESHOLD=0.18
ERIS_REASONING_EFFORT=none

# Depth features
ERIS_EMOTIONAL_CONSEQUENCE=1
ERIS_DEVELOPMENT_GROWTH_ENABLED=1
ERIS_INTERIOR_SURFACE_NONANCHORED=0
ERIS_TOM_ADVISOR=0
