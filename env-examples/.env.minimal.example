# ════════════════════════════════════════════════════════════════════════════
# PRESET: MINIMAL  (nhẹ tối đa — chỉ chat, tắt hầu hết loop nền)
# ────────────────────────────────────────────────────────────────────────────
# Dùng để test nhanh / máy rất yếu / muốn ít tốn quota nhất. Chỉ giữ chat remote;
# tắt observer, vision, private-mind, tutor, các loop tự chủ. Copy -> .env, điền key.
# ════════════════════════════════════════════════════════════════════════════

# Remote cognition API (chỉ chat)
ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=deepseek_web
ERIS_REMOTE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ERIS_REMOTE_MODEL=
ERIS_REMOTE_API_KEY=
GEMINI_API_KEY=

# Local engine tắt
ERIS_LOCAL_LLM_ENGINE=

# Private mind tắt
ERIS_PRIVATE_MIND_API_ENABLED=0

# Vision tắt
ERIS_VISION_FACTS=0
ERIS_VISION_COMPRESSOR=0
ERIS_LOCAL_VISION_FACTS=0

# Background observer tắt
ERIS_BACKGROUND_OBSERVER=0
ERIS_BACKGROUND_OBSERVER_LLM=0

# Loop tự chủ / nội tâm tắt
ERIS_MENTAL_PROCESS_LOOP=0
ERIS_THOUGHT_STREAM_LOOP=0
ERIS_PRESENCE_MAINTENANCE=0
ERIS_MICRO_PRESENCE_LLM=0
ERIS_REENGAGEMENT=0
ERIS_INNER_DIARY_AI=0
ERIS_INNER_DIARY_PERSIST=0

# Tutor tắt
ERIS_TUTOR_ENABLED=0
ERIS_SHADOW_PIPELINE=0

# Embedding hash fallback (không cần torch)
ERIS_MEANING_REAL_EMBEDDINGS=0

# Runtime cadence & guardrails
ERIS_GUARD_MODE=log_only
ERIS_NOVELTY_POSTGEN_MODE=log
ERIS_REASONING_EFFORT=none

# Depth features tắt hết
ERIS_EMOTIONAL_CONSEQUENCE=0
ERIS_DEVELOPMENT_GROWTH_ENABLED=0
ERIS_INTERIOR_SURFACE_NONANCHORED=0
ERIS_TOM_ADVISOR=0
ERIS_PRIVATE_RESIDUE_CURATOR_ENABLED=0
ERIS_ELEVENLABS_GEMINI_FALLBACK=0
ERIS_TTS_PROVIDER=elevenlabs
