# Local smoke preset for Eris.
# Copy this over .env only when you want the cheapest possible runtime check.
# Keep real keys in .env or config/secrets.json, never in Git.

ERIS_REMOTE_API_ENABLED=1
ERIS_REMOTE_PROVIDER=deepseek
ERIS_REMOTE_BASE_URL=https://api.deepseek.com
ERIS_REMOTE_MODEL=deepseek-v4-flash
ERIS_REMOTE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ERIS_GROQ_API_KEY=

ERIS_DS2API_ENABLED=0
ERIS_DS2API_BASE_URL=http://localhost:6011/v1
ERIS_DS2API_API_KEY=
ERIS_DS2API_MODEL=deepseek-chat

ERIS_TTS_ENABLED=0
ERIS_SPEECH_API_KEY=
ELEVENLABS_API_KEY=
ERIS_ELEVENLABS_API_KEY=

ERIS_LOCAL_LLM_ENGINE=
ERIS_PRIVATE_MIND_API_ENABLED=0
ERIS_VISION_FACTS=0
ERIS_VISION_COMPRESSOR=0
ERIS_LOCAL_VISION_FACTS=0
ERIS_BACKGROUND_OBSERVER=0
ERIS_BACKGROUND_OBSERVER_LLM=0
ERIS_MENTAL_PROCESS_LOOP=0
ERIS_THOUGHT_STREAM_LOOP=0
ERIS_PRESENCE_MAINTENANCE=0
ERIS_MICRO_PRESENCE_LLM=0
ERIS_REENGAGEMENT=0
ERIS_INNER_DIARY_AI=0
ERIS_INNER_DIARY_PERSIST=0
ERIS_TUTOR_ENABLED=0
ERIS_SHADOW_PIPELINE=0
ERIS_MEANING_REAL_EMBEDDINGS=0

ERIS_GUARD_MODE=log_only
ERIS_NOVELTY_POSTGEN_MODE=log
ERIS_REASONING_EFFORT=none
ERIS_PRIVATE_RESIDUE_CURATOR_ENABLED=0
ERIS_ELEVENLABS_GEMINI_FALLBACK=0
ERIS_TTS_PROVIDER=elevenlabs
