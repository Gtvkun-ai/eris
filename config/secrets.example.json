{
  "_readme": "Example secrets/config file. Copy to config/secrets.json and fill private values locally. Do not commit real API keys, tokens, passwords, emails, or local runtime databases.",
  "api_keys": {
    "ERIS_REMOTE_API_KEY": "",
    "DEEPSEEK_API_KEY": "",
    "ERIS_DS_COMPANION_API_KEY": "",
    "ERIS_DS_CRITIC_API_KEY": "",
    "ERIS_DS_INNER_API_KEY": "",
    "ERIS_DS_OBSERVER_API_KEY": "",
    "ERIS_DS_CURATOR_API_KEY": "",
    "ERIS_DS_SEED_API_KEY": "",
    "ERIS_DS_SURFACE_API_KEY": "",
    "ERIS_SPEECH_API_KEY": "",
    "ERIS_GEMINI_FALLBACK_API_KEYS": [],
    "ERIS_GROQ_API_KEY": "",
    "ERIS_GROQ_FALLBACK_API_KEYS": [],
    "ELEVENLABS_BEARER_TOKEN": "",
    "ELEVENLABS_EMAIL": "",
    "ELEVENLABS_REFRESH_TOKEN": "",
    "FIREBASE_API_KEY": "",
    "ERIS_DS_EXECUTIVE_API_KEY": "",
    "GEMINI_API_KEY": ""
  },
  "providers": {
    "deepseek": {
      "default": {
        "base_url": "https://api.deepseek.com",
        "model": "deepseek-v4-flash",
        "api_key": ""
      },
      "remote_main": {
        "base_url": "https://api.deepseek.com",
        "model": "deepseek-v4-flash",
        "api_key": ""
      }
    },
    "_notes": "DeepSeek is now the unified provider. No need to define redundant Gemini or Groq blocks unless explicitly requested by the pipeline."
  },
  "agent_keys": {
    "remote_main": {
      "provider": "deepseek",
      "slot": "default"
    },
    "search_web": {
      "provider": "deepseek",
      "slot": "default"
    },
    "get_weather": {
      "provider": "deepseek",
      "slot": "default"
    },
    "lane3_synthesis": {
      "provider": "deepseek",
      "slot": "default"
    },
    "lane5_daydream": {
      "provider": "deepseek",
      "slot": "default"
    },
    "speech": {
      "provider": "deepseek",
      "slot": "default"
    },
    "private_mind": {
      "provider": "deepseek",
      "slot": "default"
    },
    "_notes": "Agent routing configuration. By default, all lanes and roles are now funneled into DeepSeek."
  },
  "subconscious_runtime": {
    "enabled": true,
    "surface_seed_only": true,
    "scheduler": {
      "event_tick_enabled": true,
      "ambient_tick_jitter_seconds": [
        10,
        45
      ],
      "pressure_tick_enabled": true,
      "solitude_tick_window_seconds": [
        120,
        300
      ],
      "reflection_tick_window_seconds": [
        900,
        1800
      ]
    },
    "lanes": {
      "lane1_spark_pulse": {
        "enabled": true,
        "jitter_seconds": [
          5,
          20
        ],
        "allow_api": false,
        "allow_surface_seed": false,
        "notes": "ThoughtSpark, DriftPool, self-anchor, memory residue, habitat attachment."
      },
      "lane2_worker_fragment_cycle": {
        "enabled": true,
        "idle_window_seconds": [
          30,
          90
        ],
        "allow_api": false,
        "allow_surface_seed": false,
        "workers": [
          "user_modeler",
          "memory_resonator",
          "goal_simulator",
          "self_regulator",
          "curiosity_gap_agent",
          "subjective_time_agent",
          "spatial_mind_agent"
        ]
      },
      "lane3_synthesis_rehearsal": {
        "enabled": true,
        "allow_api": true,
        "allow_surface_seed": true,
        "provider": "deepseek",
        "provider_slot": "default",
        "api_key_env": "",
        "api_key_fallbacks": [],
        "base_url_env": "ERIS_REMOTE_BASE_URL",
        "model_env": "ERIS_REMOTE_MODEL",
        "model": "deepseek-v4-flash",
        "min_blackboard_coherence": 0.55,
        "min_fragment_count": 3,
        "min_blackboard_pressure": 0.6,
        "min_recurring_theme_strength": 0.65,
        "min_unresolved_loop_pressure": 0.6
      },
      "lane4_surface_candidate": {
        "enabled": true,
        "surface_score_threshold": 0.68,
        "store_private_range": [
          0.45,
          0.67
        ],
        "allow_direct_public_output": false,
        "notes": "surface_seed only -> SurfaceArbiter -> speech policy -> wording -> filters."
      },
      "lane5_deep_private_life": {
        "enabled": true,
        "idle_window_seconds": [
          600,
          1800
        ],
        "allow_api": false,
        "allow_mutation_commit": false,
        "allow_rupture_surface": false,
        "workers": [
          "daydream_injector",
          "independent_agenda_agent",
          "belief_mutation_engine",
          "shadow_accumulator"
        ]
      }
    }
  },
  "env": {
    "ERIS_REMOTE_API_ENABLED": "1",
    "ERIS_REMOTE_PROVIDER": "deepseek_web",
    "ERIS_REMOTE_MODEL": "deepseek-v4-flash",
    "ERIS_DS2API_ENABLED": "1",
    "ERIS_DS2API_PORTS": "6011,6012,6013,6014,6016",
    "ERIS_DS_MODEL": "deepseek-v4-flash",
    "ERIS_DS_SURFACE_ALLOW_SHARED_KEY": "0",
    "ERIS_DS_COMPANION_BASE_URL": "http://127.0.0.1:6011/v1",
    "ERIS_DS_SURFACE_BASE_URL": "http://127.0.0.1:6012/v1",
    "ERIS_DS_OBSERVER_BASE_URL": "http://127.0.0.1:6013/v1",
    "ERIS_DS_CRITIC_BASE_URL": "http://127.0.0.1:6014/v1",
    "ERIS_DS_INNER_BASE_URL": "http://127.0.0.1:6014/v1",
    "ERIS_DS_CURATOR_BASE_URL": "http://127.0.0.1:6014/v1",
    "ERIS_DS_SEED_BASE_URL": "http://127.0.0.1:6015/v1",
    "ERIS_DS_EXECUTIVE_BASE_URL": "http://127.0.0.1:6016/v1"
  }
}
