{
  "_notes": {
    "purpose": "Template safe de ship cho may moi. Copy file nay thanh config/secrets.json roi dien key that.",
    "open_helper": "Chay setup_secrets.bat o thu muc goc Eris de tu tao va mo config/secrets.json.",
    "do_not_commit": "Khong commit config/secrets.json, .env, database pool, token that.",
    "deepseek_pool_required": [
      "ERIS_DS_COMPANION_API_KEY",
      "ERIS_DS_SURFACE_API_KEY",
      "ERIS_DS_SEED_API_KEY",
      "ERIS_DS_EXECUTIVE_API_KEY",
      "ERIS_DS_CURATOR_API_KEY"
    ],
    "deepseek_pool_recommended": [
      "ERIS_DS_OBSERVER_API_KEY",
      "ERIS_DS_CRITIC_API_KEY",
      "ERIS_DS_INNER_API_KEY"
    ],
    "voice_optional": "De ERIS_TTS_ENABLED=0 neu chua cau hinh ElevenLabs/Gemini voice."
  },
  "api_keys": {
    "ERIS_REMOTE_API_KEY": "",
    "DEEPSEEK_API_KEY": "",
    "ERIS_DS2API_API_KEY": "",
    "ERIS_DS_COMPANION_API_KEY": "",
    "ERIS_DS_OBSERVER_API_KEY": "",
    "ERIS_DS_CRITIC_API_KEY": "",
    "ERIS_DS_INNER_API_KEY": "",
    "ERIS_DS_SURFACE_API_KEY": "",
    "ERIS_DS_SEED_API_KEY": "",
    "ERIS_DS_EXECUTIVE_API_KEY": "",
    "ERIS_DS_CURATOR_API_KEY": "",
    "ERIS_SPEECH_API_KEY": "",
    "ERIS_PRIVATE_RESIDUE_CURATOR_API_KEY": "",
    "GEMINI_API_KEY": "",
    "ERIS_GEMINI_FALLBACK_API_KEYS": [],
    "ERIS_GROQ_API_KEY": "",
    "ERIS_GROQ_FALLBACK_API_KEYS": [],
    "OPENAI_API_KEY": "",
    "ELEVENLABS_BEARER_TOKEN": "",
    "ELEVENLABS_EMAIL": "",
    "ELEVENLABS_REFRESH_TOKEN": "",
    "FIREBASE_API_KEY": ""
  },
  "env": {
    "ERIS_REMOTE_API_ENABLED": "1",
    "ERIS_REMOTE_PROVIDER": "deepseek_web",
    "ERIS_REMOTE_MODEL": "deepseek-v4-flash",
    "ERIS_DS2API_ENABLED": "1",
    "ERIS_DS2API_PORTS": "6011,6012,6013,6014,6016",
    "ERIS_DS_MODEL": "deepseek-v4-flash",
    "ERIS_DS_SURFACE_ALLOW_SHARED_KEY": "0",
    "ERIS_DS_COMPANION_BASE_URL": "http://127.0.0.1:6011/v1",
    "ERIS_DS_SURFACE_BASE_URL": "http://127.0.0.1:6012/v1",
    "ERIS_DS_OBSERVER_BASE_URL": "http://127.0.0.1:6013/v1",
    "ERIS_DS_CRITIC_BASE_URL": "http://127.0.0.1:6014/v1",
    "ERIS_DS_INNER_BASE_URL": "http://127.0.0.1:6014/v1",
    "ERIS_DS_CURATOR_BASE_URL": "http://127.0.0.1:6014/v1",
    "ERIS_DS_SEED_BASE_URL": "http://127.0.0.1:6015/v1",
    "ERIS_DS_EXECUTIVE_BASE_URL": "http://127.0.0.1:6016/v1",
    "ERIS_EXECUTIVE_CORTEX_ENABLED": "1",
    "ERIS_PRIVATE_RESIDUE_CURATOR_ENABLED": "1",
    "ERIS_PRIVATE_RESIDUE_CURATOR_PROVIDER": "gemini",
    "ERIS_PRIVATE_RESIDUE_CURATOR_MODEL": "gemma-4-26b-a4b-it",
    "ERIS_TTS_ENABLED": "0",
    "ERIS_TTS_PROVIDER": "elevenlabs",
    "ERIS_ELEVENLABS_POOL_PORT": "18888",
    "POOL_UI_ADMIN_TOKEN": "123456"
  },
  "providers": {
    "deepseek": {
      "default": {
        "base_url": "https://api.deepseek.com/v1",
        "model": "deepseek-chat"
      },
      "remote_main": {
        "base_url": "https://api.deepseek.com/v1",
        "model": "deepseek-chat"
      }
    },
    "gemini": {
      "default": {
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "model": "gemini-2.5-flash"
      },
      "private_residue_curator": {
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "model": "gemma-4-26b-a4b-it"
      },
      "speech": {
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "model": "gemini-2.5-flash"
      }
    },
    "openai_compatible": {
      "default": {
        "base_url": "https://api.groq.com/openai/v1",
        "model": "llama-3.3-70b-versatile"
      }
    }
  },
  "agent_keys": {
    "remote_main": {
      "provider": "deepseek",
      "slot": "remote_main"
    },
    "private_residue_curator": {
      "provider": "gemini",
      "slot": "private_residue_curator"
    },
    "speech": {
      "provider": "gemini",
      "slot": "speech"
    }
  },
  "subconscious_runtime": {
    "enabled": true,
    "surface_seed_only": true,
    "scheduler": {
      "event_tick_enabled": true,
      "ambient_tick_jitter_seconds": [
        10,
        45
      ],
      "pressure_tick_enabled": true,
      "solitude_tick_window_seconds": [
        120,
        300
      ],
      "reflection_tick_window_seconds": [
        900,
        1800
      ]
    }
  }
}
