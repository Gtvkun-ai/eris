# Copy the block you need into `.env`.
# Recommended rollout:
# 1. Start with background observer only.
# 2. Enable observer LLM.
# 3. Enable Ollama vision compressor for live screen understanding.

# Phase 1: observer only
ERIS_BACKGROUND_OBSERVER=1
ERIS_BACKGROUND_OBSERVER_LLM=0

# Phase 2: observer text LLM
ERIS_BACKGROUND_OBSERVER=1
ERIS_BACKGROUND_OBSERVER_LLM=1
ERIS_OBSERVER_MODEL=qwen3:0.6b
ERIS_OBSERVER_KEEP_ALIVE=30m
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_TIMEOUT_SEC=240

# Phase 3: vision rollout through Ollama
ERIS_VISION_FACTS=1
ERIS_VISION_FACTS_INTERVAL=60
ERIS_VISION_FACTS_MAX=3
ERIS_VISION_FACTS_MAX_LEN=120

ERIS_VISION_COMPRESSOR=1
ERIS_VISION_COMPRESSOR_MODEL=qwen2.5vl:3b
ERIS_VISION_KEEP_ALIVE=0
ERIS_VISION_TEMPERATURE=0
ERIS_VISION_MIN_SALIENCE=0.70
ERIS_VISION_MIN_DIFF=0.20
ERIS_VISION_MAX_OCR_CHARS=1600
ERIS_VISION_UNLOAD_AFTER_CALL=1

# Notes
# - `qwen3:0.6b` is the small text model already used for the observer.
# - `qwen2.5vl:3b` is a real Ollama vision model and is a reasonable local default.
# - Keep `ERIS_VISION_KEEP_ALIVE=0` so the vision model unloads after calls by default.
